# Copy to a private env file OUTSIDE the checkout; use your authorized user token and app credentials.
# node --env-file=C:/private/qobuz.env addons-sdk/cloud/server.mjs
# Install http://127.0.0.1:7014/manifest.json in the desktop addon manager.
# Replace expired credentials here and restart the server. No bundled credentials or browser scraping.
PROVIDER=qobuz
PORT=7014
QOBUZ_AUTH_TOKEN=
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=
