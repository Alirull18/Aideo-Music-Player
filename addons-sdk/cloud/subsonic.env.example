# Copy to a private env file OUTSIDE the checkout and set your authorized account values.
# node --env-file=C:/private/subsonic.env addons-sdk/cloud/server.mjs
# Install http://127.0.0.1:7011/manifest.json in the desktop addon manager.
PROVIDER=subsonic
PORT=7011
SUBSONIC_URL=http://127.0.0.1:4533
SUBSONIC_USER=
SUBSONIC_PASSWORD=
