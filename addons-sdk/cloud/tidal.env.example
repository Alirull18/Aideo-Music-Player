# Copy to a private env file OUTSIDE the checkout; use your authorized Tidal credentials.
# node --env-file=C:/private/tidal.env addons-sdk/cloud/server.mjs
# Install http://127.0.0.1:7013/manifest.json in the desktop addon manager.
# Supported authentication modes (no bundled client credentials, token scraping, DRM decryption, or entitlement bypass):
# 1. Static token mode: set TIDAL_ACCESS_TOKEN and TIDAL_COUNTRY_CODE (2-letter ISO).
# 2. OAuth refresh mode: set TIDAL_CLIENT_ID and TIDAL_REFRESH_TOKEN (optional TIDAL_CLIENT_SECRET, TIDAL_ACCESS_TOKEN, TIDAL_COUNTRY_CODE).
# 3. Device login flow: set TIDAL_CLIENT_ID (optional TIDAL_CLIENT_SECRET, TIDAL_COUNTRY_CODE) and use POST /auth/device + POST /auth/poll.
PROVIDER=tidal
PORT=7013
TIDAL_ACCESS_TOKEN=
TIDAL_REFRESH_TOKEN=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY_CODE=
