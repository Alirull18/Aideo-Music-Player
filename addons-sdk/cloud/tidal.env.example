# Copy to a private env file OUTSIDE the checkout; use your authorized Tidal user token.
# node --env-file=C:/private/tidal.env addons-sdk/cloud/server.mjs
# Install http://127.0.0.1:7013/manifest.json in the desktop addon manager.
# Set the country to your account region. Replace the token here when it expires; restart the server.
# No bundled client credentials, token scraping, DRM decryption, or entitlement bypass.
PROVIDER=tidal
PORT=7013
TIDAL_ACCESS_TOKEN=
TIDAL_COUNTRY_CODE=
