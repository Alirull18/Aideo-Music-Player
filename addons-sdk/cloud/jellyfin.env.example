# Copy to a private env file OUTSIDE the checkout and set your authorized server API key.
# node --env-file=C:/private/jellyfin.env addons-sdk/cloud/server.mjs
# Install http://127.0.0.1:7012/manifest.json in the desktop addon manager.
PROVIDER=jellyfin
PORT=7012
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
