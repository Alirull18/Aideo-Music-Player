<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Line" xml:lang="ms"><head><metadata><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal" leadingSilence="0.220"><translations/><songwriters><songwriter>Najwa Latif</songwriter></songwriters></iTunesMetadata></metadata></head><body dur="3:02.481"><div begin="11.695" end="30.201" itunes:songPart="Verse"><p begin="11.695" end="18.425" itunes:key="L1583">Kamu terlalu sempurna di hatiku</p><p begin="18.435" end="20.973" itunes:key="L1584">Dan kamu ...</p><p begin="20.983" end="30.201" itunes:key="L1585">Kamu memberiku bahagia di hariku whoa</p></div><div begin="30.211" end="49.359" itunes:songPart="PreChorus"><p begin="30.211" end="35.394" itunes:key="L1586">Maafkan aku yang tak pernah sedar</p><p begin="35.404" end="39.881" itunes:key="L1587">Ikhlasnya cintamu padaku</p><p begin="39.891" end="45.555" itunes:key="L1588">Maafkan aku kerna berhenti mencuba 'tuk cinta ini</p><p begin="45.565" end="49.359" itunes:key="L1589">Dan aku</p></div><div begin="49.369" end="1:26.790" itunes:songPart="Chorus"><p begin="49.369" end="54.175" itunes:key="L1590">Dan aku biar</p><p begin="54.185" end="58.926" itunes:key="L1591">Dan aku biar</p><p begin="58.936" end="1:01.278" itunes:key="L1592">Dan aku biar</p><p begin="1:01.288" end="1:04.319" itunes:key="L1593">Biarkan dirimu</p><p begin="1:04.329" end="1:09.199" itunes:key="L1594">Hilang dari pandanganku</p><p begin="1:09.209" end="1:13.983" itunes:key="L3530">Uwhoa uwhoa</p><p begin="1:13.993" end="1:18.121" itunes:key="L1595">Hilang dari pandangan</p><p begin="1:23.549" end="1:26.790" itunes:key="L1596">Hilang dari pandangan</p></div><div begin="1:47.468" end="2:06.190" itunes:songPart="Verse"><p begin="1:47.468" end="1:52.276" itunes:key="L1597">Aku lepaskan semua</p><p begin="1:52.286" end="1:57.079" itunes:key="L1598">Agar kau bahagia</p><p begin="1:57.089" end="2:01.882" itunes:key="L1599">Aku 'kan tetap mencinta</p><p begin="2:01.892" end="2:06.190" itunes:key="L1600">Dirimu</p></div><div begin="2:06.200" end="2:25.451" itunes:songPart="PreChorus"><p begin="2:06.200" end="2:08.521" itunes:key="L1601">Maafkan aku</p><p begin="2:08.531" end="2:11.310" itunes:key="L1602">Tak pernah sedar</p><p begin="2:11.320" end="2:15.797" itunes:key="L1603">Ikhlasnya cintamu padaku</p><p begin="2:15.807" end="2:17.739" itunes:key="L1604">Maafkan aku</p><p begin="2:17.749" end="2:21.531" itunes:key="L1605">Kerna berhenti mencuba 'tuk cinta ini</p><p begin="2:21.541" end="2:25.451" itunes:key="L1607">Dan aku</p></div><div begin="2:25.461" end="3:02.701" itunes:songPart="Chorus"><p begin="2:25.461" end="2:30.012" itunes:key="L1608">Dan aku biar</p><p begin="2:30.022" end="2:33.108" itunes:key="L1609">Dan aku biar</p><p begin="2:33.118" end="2:34.858" itunes:key="L1610">Biar</p><p begin="2:34.868" end="2:37.121" itunes:key="L1611">Dan aku biar</p><p begin="2:37.131" end="2:40.304" itunes:key="L1612">Biarkan dirimu</p><p begin="2:40.314" end="2:45.099" itunes:key="L1613">Hilang dari pandanganku</p><p begin="2:45.109" end="2:49.971" itunes:key="L7912">Uwhoa uwhoa</p><p begin="2:49.981" end="2:54.107" itunes:key="L1614">Hilang dari pandangan</p><p begin="2:59.483" end="3:02.701" itunes:key="L1615">Hilang dari pandangan</p></div></body></tt>