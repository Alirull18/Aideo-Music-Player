{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aideo",
  "version": "0.9.6",
  "identifier": "com.alirul.music-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "tooltip": "Aideo Music Player"
    },
    "windows": [
      {
        "label": "main",
        "title": "Aideo Music Player",
        "width": 1000,
        "height": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https: http: data: blob:; media-src 'self' asset: https: http: data: blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; script-src 'self' 'wasm-unsafe-eval';",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aideo"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}